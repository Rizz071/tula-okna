{
    "name": "tula-okna",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build --debug && next-sitemap",
        "start": "next start",
        "lint": "eslint .",
        "deploy-local-to-remote": "git add -A && git commit -am \"deploy\" && git push origin main-develop:main-develop && git checkout main && git merge main-develop  && git push origin main:main && git checkout main-develop",
        "deploy-server-with-kill": "pm2 kill && git pull && npm install && npm run build && pm2 start npm -- start",
        "deploy-server-with-reload": "git pull && npm install && npm run build && pm2 reload all"
    },
    "dependencies": {
        "@emotion/cache": "^11.14.0",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@fontsource/roboto": "^5.2.10",
        "@mui/icons-material": "^9.0.1",
        "@mui/material": "^9.0.1",
        "@mui/material-nextjs": "^9.0.1",
        "@next/third-parties": "16.2.7",
        "@types/nodemailer": "^8.0.0",
        "next": "^16.2.7",
        "next-sitemap": "^4.2.3",
        "nodemailer": "^8.0.10",
        "react": "19.2.7",
        "react-dom": "19.2.7",
        "react-to-print": "^3.3.0",
        "sharp": "^0.34.5"
    },
    "devDependencies": {
        "@types/node": "^25",
        "@types/react": "19.2.16",
        "@types/react-dom": "19.2.3",
        "eslint": "^9.39.4",
        "eslint-config-next": "16.2.7",
        "typescript": "^6"
    },
    "overrides": {
        "@types/react": "19.2.16",
        "@types/react-dom": "19.2.3"
    }
}
